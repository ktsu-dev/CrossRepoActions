<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="ConsoleTools" Version="1.2.1" />
    <PackageVersion Include="ConsoleTools.Controls" Version="1.2.1" />
    <PackageVersion Include="ConsoleTools.Controls.Menus" Version="1.2.1" />
    <PackageVersion Include="ConsoleTools.Controls.Spinners" Version="1.2.1" />
    <PackageVersion Include="ConsoleTools.Core" Version="1.2.1" />
    <PackageVersion Include="ktsu.AppDataStorage" Version="1.16.33" />
    <PackageVersion Include="ktsu.Extensions" Version="1.5.35" />
    <PackageVersion Include="ktsu.RunCommand" Version="1.4.25" />
    <PackageVersion Include="ktsu.Semantics.Paths" Version="2.9.3" />
    <PackageVersion Include="ktsu.Semantics.Strings" Version="2.9.3" />
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.6.4" />
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.79.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Abstractions" Version="1.79.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.79.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Core" Version="1.79.0" />
    <!-- Microsoft.Testing.Extensions.* versions are owned by MSTest.Sdk, which injects a matching
         PackageVersion for every extension it references. Declaring them here duplicates those
         entries and fails restore with NU1506. -->
    <PackageVersion Include="NuGet.Versioning" Version="7.6.0" />
    <PackageVersion Include="Polyfill" Version="11.0.2" />
    <PackageVersion Include="System.Management.Automation" Version="7.6.4" />
    <!-- Transitive of Microsoft.PowerShell.SDK / System.Management.Automation; pinned forward off
         the vulnerable 10.0.6 those packages resolve to (NU1903). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
</Project>